% READ IN FULL (18 pages, arXiv v1).  Decision space, confirmed from the
%   algorithm itself: the unexplored region is X_l, a subset of X carried as
%   constraints on x; branching is x_j <= floor(a_j) / x_j >= floor(a_j)+1;
%   both cut families are linear inequalities in x.  Its cut of type I is
%   sum_{j in Delta_l} x_j >= 1 over the improving nonbasic directions --
%   ONE row, no binaries, no big-M -- and its efficiency test is Benson's
%   program (Q), not the Sylva-Crema/Isermann pair.  See benson1978.
%   Its own reference list corroborates drici2018 (three authors),
%   mahdi2015, eckerkouada (375-377), ozlen2009, sylvacrema and boland2017.
@misc{ouail2019,
  author       = {Oua{\"\i}l, Fatma Zohra and Chergui, Mohamed El-Amine},
  title        = {Hyperbolic optimization over the integer efficient set of
                  {MOILFP}},
  howpublished = {arXiv:1907.02036 [math.OC]},
  year         = {2019}
}

