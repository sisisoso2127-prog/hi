% READ IN FULL (18 pages, arXiv v1).  Decision space, confirmed from the
%   algorithm itself: the unexplored region is X_l, a subset of X carried as
%   constraints on x; branching is x_j <= floor(a_j) / x_j >= floor(a_j)+1;
%   both cut families are linear inequalities in x.  Its cut of type I is
%   sum_{j in Delta_l} x_j >= 1 over the improving nonbasic directions --
%   ONE row, no binaries, no big-M -- and its efficiency test is Benson's
%   program (Q), not the Sylva-Crema/Isermann pair.  See benson1978.
%   Its own reference list corroborates drici2018 (three authors),
%   mahdi2015, eckerkouada (375-377), ozlen2009, sylvacrema and boland2017.
@misc{ouail2019,
  author       = {Oua{\"\i}l, Fatma Zohra and Chergui, Mohamed El-Amine},
  title        = {Hyperbolic optimization over the integer efficient set of
                  {MOILFP}},
  howpublished = {arXiv:1907.02036 [math.OC]},
  year         = {2019}
}

% READ IN FULL (20 pages, arXiv v1).  The two-decision-function problem,
%   decision space: X_l carried as constraints on x, branching on
%   x_r <= floor / x_r >= ceil, and TWO single-row efficient cuts
%   sum_{j in H_l} x_j >= 1 and sum_{j in H'_l} x_j >= 1 -- no binaries.
%   Its efficiency test linearises the ratio exactly as our e_row does,
%   (c^i - Z_i(x*)d^i)x - w_i = Z_i(x*)d_0 - c_0, which is our e_k divided
%   by D_k(x*): the linearisation is standard in this school, the integer
%   SCALING that turns "> 0" into ">= 1" is not.  Uses CPLEX 12.9 under
%   MATLAB; scale to n=80, m=160.  Its tables give |XE| directly: about
%   22-38 at r=3 and 40-150 at r=5.
%
% RESOLVED: the third author is Yasmine Cherfaoui, from the title page
%   (the LaROMaD address ycherfaoui at usthb.dz) -- the same author as cherfaoui2021.
@misc{chaiblaine2020,
  author       = {Chaiblaine, Yacine and Moula{\"\i}, Mustapha and
                  Cherfaoui, Yasmine},
  title        = {An exact method for optimizing two linear fractional
                  functions over the efficient set of a multiobjective
                  integer linear fractional program},
  howpublished = {arXiv:2003.05364 [math.OC]},
  year         = {2020}
}

