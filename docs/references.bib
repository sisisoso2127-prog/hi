% ===== The efficiency test, attributed precisely ===========================
% Our one-program test -- max sum_k e_k subject to e_k >= 0 -- is the form the
% base method states, and the two classical sources differ in what each
% supplies.  Isermann gives the test; Ecker and Kouada give the fact that its
% maximiser is itself efficient in the linear case, which is what the repair
% step relies on; Benson's (Q) is the variant ouail2019 uses.

% PROVENANCE: reference [25] of ouail2019, read in full.  Not independently
%   confirmed in an index -- open it before relying on the attribution.
@article{isermann1974,
  author  = {Isermann, Heinz},
  title   = {Proper efficiency and the linear vector maximization problem},
  journal = {Operations Research},
  volume  = {22},
  number  = {1},
  pages   = {189--191},
  year    = {1974}
}

% PROVENANCE: reference [52] of ouail2019, read in full, cited there for the
%   efficiency test (Q).  Not independently confirmed in an index.
@article{benson1978,
  author  = {Benson, Harold P.},
  title   = {Existence of efficient solutions for vector maximization
             problems},
  journal = {Journal of Optimization Theory and Applications},
  volume  = {26},
  number  = {4},
  pages   = {569--580},
  year    = {1978}
}
